{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["npx.cmd","-y", "nx", "mcp"],
      "enabled": true
    },
    "spring-docs": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@enokdev/springdocs-mcp"],
      "enabled": true
    },
    "Context7": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx.cmd",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx.cmd", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
